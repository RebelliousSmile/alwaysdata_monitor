{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}

{# ------------------------------------------------------------------ #}
{# Flash messages                                                       #}
{# ------------------------------------------------------------------ #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{% if label == 'success' %}success{% elseif label == 'error' %}danger{% else %}info{% endif %} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}
{% endfor %}

{# ------------------------------------------------------------------ #}
{# Top action bar                                                       #}
{# ------------------------------------------------------------------ #}
<div class="d-flex align-items-center mb-3">
    <button type="button" class="btn btn-outline-secondary btn-sm mr-2" id="btn-toggle-config">
        <i class="material-icons" style="font-size:1rem;vertical-align:middle">settings</i>
        Paramètres
    </button>
    {% if logsPath is not empty %}
    <button type="button" class="btn btn-primary btn-sm" id="btn-analyse">
        <i class="material-icons" style="font-size:1rem;vertical-align:middle">refresh</i>
        Actualiser
    </button>
    <div id="analyse-spinner" class="ml-2" style="display:none">
        <div class="spinner-border spinner-border-sm text-primary" role="status">
            <span class="sr-only">Analyse en cours...</span>
        </div>
        <span class="ml-1 text-muted small">Analyse en cours...</span>
    </div>
    {% endif %}
</div>

{# ------------------------------------------------------------------ #}
{# Configuration form (hidden if already configured)                   #}
{# ------------------------------------------------------------------ #}
<div id="config-section" class="card mb-4" {% if logsPath is not empty %}style="display:none"{% endif %}>
    <div class="card-header">
        <h3 class="card-header-title">
            <i class="material-icons">settings</i>
            Configuration
        </h3>
    </div>
    <div class="card-body">
        {% if logsPath is empty %}
        <div class="alert alert-warning">
            <i class="material-icons align-middle mr-1" style="font-size:1rem">warning</i>
            Configurez le chemin des logs pour commencer.
        </div>
        {% endif %}
        <form method="post" action="{{ path('sc_alwaysdata_index') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sc_alwaysdata_index') }}">

            <div class="form-group">
                <label for="logs_path">Chemin des logs</label>
                <input
                    type="text"
                    id="logs_path"
                    name="logs_path"
                    class="form-control"
                    value="{{ logsPath }}"
                    placeholder="{{ logsPathHint }}"
                    required
                >
                <small class="form-text text-muted">
                    Chemin absolu vers le répertoire des logs Alwaysdata (ex : {{ logsPathHint }})
                </small>
            </div>

            <div class="form-group">
                <label for="htaccess_path">Chemin .htaccess</label>
                <input
                    type="text"
                    id="htaccess_path"
                    name="htaccess_path"
                    class="form-control"
                    value="{{ htaccessPath }}"
                >
                <small class="form-text text-muted">
                    Chemin absolu vers le fichier .htaccess de PrestaShop.
                </small>
            </div>

            <div class="form-group">
                <label>Lignes lues (tail -n) par source</label>
                <div class="form-row">
                    {% for dir, default in {apache: 5000, http: 10000, php: 5000, sites: 2000} %}
                    <div class="col-md-3">
                        <div class="input-group mb-2">
                            <div class="input-group-prepend">
                                <span class="input-group-text" style="min-width:60px">{{ dir }}</span>
                            </div>
                            <input type="number" name="lines_{{ dir }}" class="form-control"
                                   value="{{ linesPerSource[dir] ?? default }}" min="100" max="100000">
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <small class="form-text text-muted">Nombre de lignes lues depuis la fin de chaque fichier log.</small>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="material-icons">save</i>
                Sauvegarder
            </button>
        </form>
    </div>
</div>

{% if logsPath is empty %}
<div class="alert alert-info">
    <i class="material-icons align-middle mr-1">info</i>
    Renseignez le chemin des logs ci-dessus pour démarrer l'analyse.
</div>
{% endif %}

<input type="hidden" id="csrf-apply-block" value="{{ csrf_token('sc_alwaysdata_apply_block') }}">

{# ------------------------------------------------------------------ #}
{# Stats & Conversion — chargées depuis la base (cron J-1)            #}
{# ------------------------------------------------------------------ #}
<div class="card mb-4" id="stats-section">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap" style="gap:.5rem">
        <ul class="nav nav-tabs card-header-tabs" id="stats-nav-tabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="tab-trafic-link" data-toggle="tab" href="#tab-trafic" role="tab">
                    <i class="material-icons align-middle" style="font-size:1rem">bar_chart</i>
                    Statistiques trafic
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="tab-conversion-link" data-toggle="tab" href="#tab-conversion" role="tab">
                    <i class="material-icons align-middle" style="font-size:1rem">trending_down</i>
                    Conversion
                </a>
            </li>
        </ul>
        <div class="d-flex align-items-center" style="gap:.5rem">
            <input type="date" id="stats-date-picker" class="form-control form-control-sm" style="width:auto">
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary stats-period active" data-period="30">30j</button>
                <button type="button" class="btn btn-outline-secondary stats-period" data-period="7">7j</button>
            </div>
            <div id="stats-spinner" style="display:none">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            </div>
        </div>
    </div>
    <div class="tab-content" id="stats-tab-content">

        {# --- Tab Trafic --- #}
        <div class="tab-pane fade show active p-3" id="tab-trafic" role="tabpanel">
            <div id="tab-trafic-content">
                <div class="text-center text-muted py-4">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                    Chargement…
                </div>
            </div>
        </div>

        {# --- Tab Conversion --- #}
        <div class="tab-pane fade p-3" id="tab-conversion" role="tabpanel">
            <div id="tab-conversion-content">
                <div class="text-center text-muted py-4">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                    Chargement…
                </div>
            </div>
        </div>

    </div>
</div>

{# ------------------------------------------------------------------ #}
{# Results (populated by JS)                                           #}
{# ------------------------------------------------------------------ #}
<div id="results-section" style="display:none">

    {# Source status badges #}
    <div id="sources-status" class="mb-3"></div>

    {# Log viewer — tabs built by JS #}
    <div class="card mb-4" id="logs-viewer-section">
        <div class="card-header">
            <h3 class="card-header-title">
                <i class="material-icons">list_alt</i>
                Logs du jour
            </h3>
        </div>
        <div class="card-body p-0">
            <ul class="nav nav-tabs px-3 pt-2" id="logs-tabs" role="tablist"></ul>
            <div class="tab-content" id="logs-tab-content"></div>
        </div>
    </div>

</div>

{# ------------------------------------------------------------------ #}
{# Inline JavaScript                                                    #}
{# ------------------------------------------------------------------ #}
<script>
var analyseUrl = '{{ path('sc_alwaysdata_analyse') }}';
var applyBlockUrl = '{{ path('sc_alwaysdata_apply_block') }}';
var applyUnblockUrl = '{{ path('sc_alwaysdata_apply_unblock') }}';
var statsUrl = '{{ statsUrl }}';
var conversionUrl = '{{ conversionUrl }}';
</script>

<script>
(function() {
    var yesterday = (function() {
        var d = new Date(); d.setDate(d.getDate() - 1);
        return d.toISOString().slice(0, 10);
    })();

    var currentPeriod = 30;
    var currentDate = yesterday;
    var activeTab = 'trafic';

    var datePicker = document.getElementById('stats-date-picker');
    var spinner = document.getElementById('stats-spinner');
    if (datePicker) { datePicker.value = yesterday; datePicker.max = yesterday; }

    function esc(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function pct(a, b) {
        if (!b || b === 0) return '-';
        return Math.round(a / b * 100) + '%';
    }

    function fetchStats() {
        if (spinner) spinner.style.display = 'inline-block';
        var url = statsUrl + '?date=' + currentDate + '&period=' + currentPeriod;
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.json(); })
            .then(function(d) { renderTrafic(d); })
            .catch(function(e) { document.getElementById('tab-trafic-content').innerHTML = '<div class="alert alert-danger">Erreur: ' + esc(e.message) + '</div>'; })
            .finally(function() { if (spinner) spinner.style.display = 'none'; });
    }

    function fetchConversion() {
        if (spinner) spinner.style.display = 'inline-block';
        var url = conversionUrl + '?date=' + currentDate + '&period=' + currentPeriod;
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.json(); })
            .then(function(d) { renderConversion(d); })
            .catch(function(e) { document.getElementById('tab-conversion-content').innerHTML = '<div class="alert alert-danger">Erreur: ' + esc(e.message) + '</div>'; })
            .finally(function() { if (spinner) spinner.style.display = 'none'; });
    }

    function fetchActive() {
        if (activeTab === 'trafic') fetchStats();
        else fetchConversion();
    }

    function renderTrafic(data) {
        var s = data.snapshot;
        var el = document.getElementById('tab-trafic-content');
        if (!el) return;

        if (!s) {
            el.innerHTML = '<div class="alert alert-info">Aucune donnée pour le ' + esc(currentDate) + '. Le cron a-t-il tourné ?</div>'
                + renderCronConfig(data);
            return;
        }

        // Snapshot cards
        var cards = [
            ['Requêtes totales', s.requests_total, 'secondary'],
            ['Requêtes humaines', s.requests_human, 'primary'],
            ['Desktop', s.desktop, 'info'],
            ['Mobile', s.mobile, 'info'],
            ['500 front', s.errors_500_front, s.errors_500_front > 0 ? 'danger' : 'success'],
            ['500 BO', s.errors_500_bo, s.errors_500_bo > 0 ? 'warning' : 'success'],
            ['500 checkout', s.errors_500_checkout, s.errors_500_checkout > 0 ? 'danger' : 'success'],
        ].map(function(c) {
            return '<div class="col-6 col-md-3 col-lg-auto mb-2">'
                + '<div class="card border-' + c[2] + ' text-center px-3 py-2" style="min-width:110px">'
                + '<div class="small text-muted">' + esc(c[0]) + '</div>'
                + '<div class="h4 mb-0 text-' + c[2] + '">' + esc(String(c[1])) + '</div>'
                + '</div></div>';
        }).join('');

        // Top pages
        var pages = (s.top_pages || []).slice(0, 10);
        var pagesRows = pages.length
            ? pages.map(function(p) {
                return '<tr><td><small>' + esc(p.path) + '</small></td><td class="text-right">' + esc(String(p.count)) + '</td></tr>';
            }).join('')
            : '<tr><td colspan="2" class="text-muted text-center">-</td></tr>';

        // Hourly
        var hourly = s.hourly_breakdown || {};
        var hourlyRows = Object.keys(hourly).map(function(h) {
            return '<tr><td>' + esc(h) + 'h</td><td>' + esc(String(hourly[h])) + '</td></tr>';
        }).filter(function(_, i) { return hourly[Object.keys(hourly)[i]] > 0; }).join('');

        // Period table
        var periodRows = (data.period || []).map(function(r) {
            return '<tr><td>' + esc(r.stat_date) + '</td><td>' + esc(String(r.requests_human)) + '</td>'
                + '<td>' + esc(String(r.views_product)) + '</td>'
                + '<td>' + (r.errors_500_front > 0 ? '<span class="badge badge-danger">' + r.errors_500_front + '</span>' : '0') + '</td>'
                + '</tr>';
        }).join('') || '<tr><td colspan="4" class="text-muted text-center">Aucune donnée sur la période</td></tr>';

        // 500 checkout detail
        var detail500 = (s.errors_500_checkout_detail || []);
        var detail500Html = detail500.length
            ? '<table class="table table-sm"><thead class="thead-light"><tr><th>Heure</th><th>Path</th><th>IP</th></tr></thead><tbody>'
              + detail500.map(function(e) {
                  return '<tr><td>' + esc(String(e.hour)) + 'h</td><td><small>' + esc(e.path) + '</small></td><td><code>' + esc(e.ip) + '</code></td></tr>';
              }).join('') + '</tbody></table>'
            : '<p class="text-muted">Aucune erreur 500 sur /commande ce jour.</p>';

        el.innerHTML = '<div class="row no-gutters mb-3">' + cards + '</div>'
            + '<div class="row">'
            + '<div class="col-md-6 mb-3"><h6>Top 10 pages</h6>'
            + '<table class="table table-sm"><thead class="thead-light"><tr><th>Page</th><th class="text-right">Vues</th></tr></thead><tbody>' + pagesRows + '</tbody></table></div>'
            + '<div class="col-md-6 mb-3"><h6>Détail 500 checkout</h6>' + detail500Html + '</div>'
            + '</div>'
            + '<h6>Évolution sur ' + currentPeriod + 'j</h6>'
            + '<table class="table table-sm"><thead class="thead-light"><tr><th>Date</th><th>Humaines</th><th>Vues produit</th><th>500 front</th></tr></thead><tbody>' + periodRows + '</tbody></table>'
            + renderCronConfig(data);
    }

    function renderCronConfig(data) {
        if (!data.cronToken) return '';
        return '<div class="mt-3 p-2 bg-light rounded"><small class="text-muted d-block mb-1">URL cron Alwaysdata :</small>'
            + '<div class="input-group input-group-sm"><input type="text" class="form-control font-monospace" id="cron-url-input" value="' + esc(data.cronUrl || '') + '" readonly>'
            + '<div class="input-group-append"><button class="btn btn-outline-secondary" type="button" onclick="var i=document.getElementById(\'cron-url-input\');i.select();document.execCommand(\'copy\')">Copier</button></div>'
            + '</div></div>';
    }

    function renderConversion(data) {
        var s = data.snapshot;
        var el = document.getElementById('tab-conversion-content');
        if (!el) return;

        if (!s) {
            el.innerHTML = '<div class="alert alert-info">Aucune donnée pour le ' + esc(currentDate) + '. Le cron a-t-il tourné ?</div>';
            return;
        }

        var steps = [
            ['Vues produit',       s.views_product,    null],
            ['Ajouts panier',      s.cart_adds,        s.views_product],
            ['Vues panier',        s.views_cart,       s.cart_adds],
            ['Vues checkout',      s.views_checkout,   s.views_cart],
            ['POST checkout',      s.post_checkout,    s.views_checkout],
            ['Commandes confirmées', s.orders_confirmed, s.post_checkout],
        ];

        var funnelRows = steps.map(function(step) {
            return '<tr><td>' + esc(step[0]) + '</td>'
                + '<td class="text-right font-weight-bold">' + esc(String(step[1])) + '</td>'
                + '<td class="text-right text-muted">' + (step[2] !== null ? pct(step[1], step[2]) : '—') + '</td>'
                + '</tr>';
        }).join('');

        var periodRows = (data.period || []).map(function(r) {
            return '<tr><td>' + esc(r.stat_date) + '</td>'
                + '<td>' + esc(String(r.views_product)) + '</td>'
                + '<td>' + esc(String(r.cart_adds)) + '</td>'
                + '<td>' + esc(String(r.post_checkout)) + '</td>'
                + '<td><strong>' + esc(String(r.orders_confirmed)) + '</strong></td></tr>';
        }).join('') || '<tr><td colspan="5" class="text-muted text-center">Aucune donnée sur la période</td></tr>';

        var detail500 = (s.errors_500_checkout_detail || []);
        var detail500Html = detail500.length
            ? '<table class="table table-sm"><thead class="thead-light"><tr><th>Heure</th><th>Path</th><th>IP</th></tr></thead><tbody>'
              + detail500.map(function(e) {
                  return '<tr><td>' + esc(String(e.hour)) + 'h</td><td><small>' + esc(e.path) + '</small></td><td><code>' + esc(e.ip) + '</code></td></tr>';
              }).join('') + '</tbody></table>'
            : '<p class="text-muted small">Aucune erreur 500 sur /commande.</p>';

        el.innerHTML = '<div class="row">'
            + '<div class="col-md-5 mb-3"><h6>Funnel — ' + esc(currentDate) + '</h6>'
            + '<table class="table table-sm"><thead class="thead-light"><tr><th>Étape</th><th class="text-right">N</th><th class="text-right">Taux</th></tr></thead><tbody>' + funnelRows + '</tbody></table></div>'
            + '<div class="col-md-7 mb-3"><h6>Erreurs 500 checkout</h6>' + detail500Html + '</div>'
            + '</div>'
            + '<h6>Évolution sur ' + currentPeriod + 'j</h6>'
            + '<table class="table table-sm"><thead class="thead-light"><tr><th>Date</th><th>Vues produit</th><th>Ajouts panier</th><th>POST checkout</th><th>Commandes</th></tr></thead><tbody>' + periodRows + '</tbody></table>';
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Date picker
        if (datePicker) {
            datePicker.addEventListener('change', function() {
                currentDate = this.value || yesterday;
                fetchActive();
            });
        }

        // Period buttons
        document.querySelectorAll('.stats-period').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.stats-period').forEach(function(b) { b.classList.remove('active'); });
                this.classList.add('active');
                currentPeriod = parseInt(this.dataset.period, 10);
                fetchActive();
            });
        });

        // Tab switch
        document.querySelectorAll('#stats-nav-tabs a[data-toggle="tab"]').forEach(function(a) {
            a.addEventListener('shown.bs.tab', function(e) {
                activeTab = e.target.id === 'tab-trafic-link' ? 'trafic' : 'conversion';
                fetchActive();
            });
        });

        // Initial load
        fetchStats();
    });
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('btn-analyse');
    var spinner = document.getElementById('analyse-spinner');
    var results = document.getElementById('results-section');
    var configSection = document.getElementById('config-section');
    var btnToggleConfig = document.getElementById('btn-toggle-config');

    // Toggle config form
    btnToggleConfig.addEventListener('click', function() {
        var hidden = configSection.style.display === 'none';
        configSection.style.display = hidden ? 'block' : 'none';
    });

    if (!btn) return;

    function runAnalysis() {
        btn.disabled = true;
        spinner.style.display = 'inline-flex';
        results.style.display = 'none';

        fetch(analyseUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({_token: getCsrfToken()})
        })
        .then(function(r) {
            var contentType = r.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
                return r.text().then(function(html) {
                    throw new Error('Le serveur a renvoyé du HTML (status ' + r.status + '). Vérifiez les logs serveur ou videz le cache Symfony.');
                });
            }
            return r.json();
        })
        .then(function(data) { renderResults(data); })
        .catch(function(err) { showError(err.message); })
        .finally(function() {
            btn.disabled = false;
            spinner.style.display = 'none';
        });
    }

    btn.addEventListener('click', runAnalysis);

    // Auto-run on page load
    runAnalysis();

    function renderResults(data) {
        if (data.error) {
            showError(data.error);
            return;
        }
        results.style.display = 'block';
        renderSources(data.sources || []);
        renderLogViewer(data.sources || [], data.crawlers || [], data.php_errors || [], data.blocked_ips || [], data.blocked_uas || []);
    }

    function renderSources(sources) {
        var container = document.getElementById('sources-status');
        if (!container) return;
        if (!sources.length) { container.innerHTML = ''; return; }
        container.innerHTML = sources.map(function(s) {
            var cls = 'success';
            var label = escapeHtml(s.source);
            if (s.error) {
                cls = 'danger';
                label += ': ' + escapeHtml(s.error);
            } else if (s.truncated) {
                cls = 'warning';
                label += ' (tronqu\u00e9)';
            }
            return '<span class="badge badge-' + cls + ' mr-1">' + label + '</span>';
        }).join('');
    }

    function renderLogViewer(sources, crawlers, phpErrors, blockedIps, blockedUas) {
        var tabs = document.getElementById('logs-tabs');
        var content = document.getElementById('logs-tab-content');
        if (!tabs || !content) return;

        tabs.innerHTML = '';
        content.innerHTML = '';

        var savedTab = localStorage.getItem('sc_alwaysdata_tab') || '';

        sources.forEach(function(s, i) {
            var id = 'log-tab-' + s.source;
            var isActive = savedTab ? (id === savedTab) : (i === 0);
            var active = isActive ? ' active' : '';
            var show = isActive ? ' show active' : '';

            var label = s.source;
            if (s.error) {
                label += ' <span class="badge badge-danger ml-1">erreur</span>';
            } else {
                label += ' <span class="badge badge-secondary ml-1">' + (s.line_count || 0) + ' lignes</span>';
            }

            tabs.innerHTML += '<li class="nav-item">'
                + '<a class="nav-link' + active + '" data-toggle="tab" href="#' + id + '" data-tab-id="' + id + '">' + label + '</a>'
                + '</li>';

            var analysisBlock = '';
            if (s.source === 'http') {
                analysisBlock = buildCrawlersBlock(crawlers || [], blockedIps || [], blockedUas || []);
            } else if (s.source === 'php') {
                analysisBlock = buildPhpErrorsBlock(phpErrors || []);
            }

            var logBlock;
            if (s.error) {
                logBlock = '<div class="alert alert-danger m-3">' + escapeHtml(s.error) + '</div>';
            } else if (!s.preview || !s.preview.length) {
                logBlock = '<div class="alert alert-info m-3">Aucune ligne disponible.</div>';
            } else {
                var lines = s.preview.map(function(l) { return escapeHtml(l); }).join('\n');
                logBlock = '<pre class="m-0 p-3" style="font-size:0.75rem;max-height:400px;overflow-y:auto;background:#1e1e1e;color:#d4d4d4;white-space:pre-wrap;word-break:break-all;">'
                    + lines + '</pre>';
            }

            content.innerHTML += '<div class="tab-pane fade' + show + '" id="' + id + '">'
                + analysisBlock + logBlock + '</div>';
        });

        tabs.querySelectorAll('a[data-toggle="tab"]').forEach(function(a) {
            a.addEventListener('shown.bs.tab', function() {
                localStorage.setItem('sc_alwaysdata_tab', this.dataset.tabId);
            });
        });

        attachBlockHandlers();
        attachUnblockHandlers();
    }

    function buildCrawlersBlock(crawlers, blockedIps, blockedUas) {
        // Crawlers detected in today's logs, not yet blocked
        var active = crawlers.filter(function(c) { return !c.already_blocked; });

        // Index crawlers-from-log by IP for quick lookup (to enrich the blocked section)
        var crawlerByIp = {};
        crawlers.forEach(function(c) {
            (c.ips || []).forEach(function(ip) { crawlerByIp[ip] = c; });
        });

        var theadDetected = '<thead class="thead-light"><tr>'
            + '<th>Bot / IP</th><th>User-Agents</th><th>Requ\u00eates/jour</th><th>Raison</th><th>Action</th>'
            + '</tr></thead>';

        // --- Section 1 : crawlers détectés aujourd'hui (non bloqués) ---
        var activeRows = active.length
            ? active.map(function(c) {
                var isKnown = c.reason === 'known_bot';
                var ipList = c.ips || [];

                // Bot/IP column
                var ipCell;
                if (isKnown) {
                    ipCell = '<strong>' + escapeHtml(c.matched_bot || '') + '</strong>'
                        + (ipList.length ? '<br><small class="text-muted">' + ipList.length + '\u00a0IP(s)</small>' : '');
                } else {
                    ipCell = '<code>' + escapeHtml(ipList[0] || '?') + '</code>';
                }

                // UA column
                var uaList = c.user_agents || [];
                var uaCell = uaList.length
                    ? '<small style="word-break:break-all">' + escapeHtml(uaList[0]) + '</small>'
                      + (uaList.length > 1 ? ' <span class="badge badge-light">+' + (uaList.length - 1) + '</span>' : '')
                    : '<em class="text-muted">-</em>';

                // Actions
                var actions;
                if (isKnown) {
                    actions = '<button class="btn btn-sm btn-danger apply-block" data-type="ua" data-value="' + escapeAttr(c.matched_bot || '') + '">'
                        + 'Bloquer ' + escapeHtml(c.matched_bot || '') + '</button>';
                } else {
                    actions = '<button class="btn btn-sm btn-danger apply-block" data-type="ip" data-value="' + escapeAttr(ipList[0] || '') + '">'
                        + 'Bloquer l\'IP</button>';
                }

                var reasonBadge = '<span class="badge badge-' + (isKnown ? 'warning' : 'info') + '">'
                    + (isKnown ? 'Bot connu' : 'Haute fr\u00e9quence') + '</span>';

                return '<tr>'
                    + '<td style="min-width:140px">' + ipCell + '</td>'
                    + '<td>' + uaCell + '</td>'
                    + '<td class="text-right">' + escapeHtml(String(c.request_count)) + '</td>'
                    + '<td>' + reasonBadge + '</td>'
                    + '<td style="white-space:nowrap">' + actions + '</td>'
                    + '</tr>';
            }).join('')
            : '<tr><td colspan="5" class="text-center text-muted">Aucun nouveau crawler invasif d\u00e9tect\u00e9</td></tr>';

        var html = '<div class="p-3 border-bottom">'
            + '<h6 class="mb-2"><i class="material-icons align-middle" style="font-size:1rem">bug_report</i>'
            + ' Crawlers d\u00e9tect\u00e9s aujourd\'hui'
            + (active.length ? ' <span class="badge badge-danger ml-1">' + active.length + '</span>' : '')
            + '</h6>'
            + '<table class="table table-sm mb-0">' + theadDetected + '<tbody>' + activeRows + '</tbody></table>'
            + '</div>';

        // --- Section 2 : règles .htaccess existantes (avec bouton Débloquer) ---
        var hasBlocked = blockedIps.length > 0 || blockedUas.length > 0;
        var theadBlocked = '<thead class="thead-light"><tr><th>Type</th><th>Valeur</th><th>Requ\u00eates aujourd\'hui</th><th>Action</th></tr></thead>';

        var blockedRows = '';

        blockedIps.forEach(function(ip) {
            var entry = crawlerByIp[ip];
            var count = entry ? entry.request_count : '-';
            blockedRows += '<tr data-blocked-type="ip" data-blocked-value="' + escapeAttr(ip) + '">'
                + '<td><span class="badge badge-secondary">IP</span></td>'
                + '<td><code>' + escapeHtml(ip) + '</code></td>'
                + '<td>' + escapeHtml(String(count)) + '</td>'
                + '<td><button class="btn btn-sm btn-outline-warning apply-unblock" data-type="ip" data-value="' + escapeAttr(ip) + '">D\u00e9bloquer</button></td>'
                + '</tr>';
        });

        blockedUas.forEach(function(ua) {
            blockedRows += '<tr data-blocked-type="ua" data-blocked-value="' + escapeAttr(ua) + '">'
                + '<td><span class="badge badge-secondary">User-Agent</span></td>'
                + '<td><small>' + escapeHtml(ua) + '</small></td>'
                + '<td>-</td>'
                + '<td><button class="btn btn-sm btn-outline-warning apply-unblock" data-type="ua" data-value="' + escapeAttr(ua) + '">D\u00e9bloquer</button></td>'
                + '</tr>';
        });

        if (!hasBlocked) {
            blockedRows = '<tr><td colspan="4" class="text-center text-muted">Aucune r\u00e8gle de blocage dans .htaccess</td></tr>';
        }

        html += '<div class="p-3 border-bottom">'
            + '<h6 class="mb-2"><i class="material-icons align-middle" style="font-size:1rem">block</i>'
            + ' D\u00e9j\u00e0 bloqu\u00e9s dans .htaccess'
            + (hasBlocked ? ' <span class="badge badge-secondary ml-1">' + (blockedIps.length + blockedUas.length) + '</span>' : '')
            + '</h6>'
            + '<table class="table table-sm mb-0">' + theadBlocked + '<tbody>' + blockedRows + '</tbody></table>'
            + '</div>';

        return html;
    }

    function buildPhpErrorsBlock(errors) {
        var cls = {fatal:'danger',error:'danger',warning:'warning',notice:'secondary',deprecated:'light'};
        var rows = !errors.length
            ? '<tr><td colspan="5" class="text-center text-muted">Aucune erreur PHP d\u00e9tect\u00e9e</td></tr>'
            : errors.map(function(e) {
                var c = cls[e.level] || 'secondary';
                var f = String(e.file || '');
                f = f.length > 60 ? '...' + f.slice(-60) : f;
                return '<tr><td><span class="badge badge-' + c + '">' + escapeHtml(e.level) + '</span></td>'
                    + '<td><small>' + escapeHtml(f) + '</small></td>'
                    + '<td>' + escapeHtml(String(e.line || '-')) + '</td>'
                    + '<td><small>' + escapeHtml(e.message || '') + '</small></td>'
                    + '<td>' + escapeHtml(String(e.count || 0)) + '</td></tr>';
            }).join('');
        return '<div class="p-3 border-bottom">'
            + '<h6 class="mb-2"><i class="material-icons align-middle" style="font-size:1rem">error_outline</i> Erreurs PHP</h6>'
            + '<table class="table table-sm mb-0"><thead class="thead-light"><tr>'
            + '<th>Niveau</th><th>Fichier</th><th>Ligne</th><th>Message</th><th>Occurrences</th>'
            + '</tr></thead><tbody>' + rows + '</tbody></table></div>';
    }

    function attachUnblockHandlers() {
        document.querySelectorAll('.apply-unblock').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var type = this.dataset.type;
                var value = this.dataset.value;
                var row = this.closest('tr');
                var self = this;
                self.disabled = true;

                var formData = new URLSearchParams();
                formData.append('_token', getCsrfToken());
                formData.append('type', type);
                formData.append('value', value);

                fetch(applyUnblockUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData.toString()
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        row.style.opacity = '0.4';
                        row.querySelector('td:last-child').innerHTML = '<span class="badge badge-light">D\u00e9bloqu\u00e9</span>';
                    } else {
                        alert('Erreur: ' + (data.message || 'Erreur inconnue'));
                        self.disabled = false;
                    }
                })
                .catch(function() {
                    self.disabled = false;
                });
            });
        });
    }

    function attachBlockHandlers() {
        document.querySelectorAll('.apply-block').forEach(function(blockBtn) {
            blockBtn.addEventListener('click', function() {
                var type = this.dataset.type;
                var value = this.dataset.value;
                var row = this.closest('tr');
                var self = this;
                self.disabled = true;

                var formData = new URLSearchParams();
                formData.append('_token', getCsrfToken());
                formData.append('type', type);
                formData.append('value', value);

                fetch(applyBlockUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData.toString()
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        row.querySelector('td:last-child').innerHTML = '<span class="badge badge-secondary">D\u00e9j\u00e0 bloqu\u00e9</span>';
                        row.classList.add('text-muted');
                    } else {
                        alert('Erreur: ' + (data.message || 'Erreur inconnue'));
                        self.disabled = false;
                    }
                })
                .catch(function() {
                    self.disabled = false;
                });
            });
        });
    }

    function getCsrfToken() {
        var input = document.getElementById('csrf-apply-block');
        return input ? input.value : '';
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function escapeAttr(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function showError(msg) {
        results.style.display = 'block';
        results.innerHTML = '<div class="alert alert-danger">'
            + '<i class="material-icons align-middle mr-1">error</i>'
            + escapeHtml(msg)
            + '</div>';
    }
});
</script>

{% endblock %}
