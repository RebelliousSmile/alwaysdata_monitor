<div class="tab-pane fade" id="tab-htaccess" role="tabpanel">
<div class="pt-3">

{# ------------------------------------------------------------------ #}
{# .htaccess health: diagnostic, active blocks, backup history        #}
{# ------------------------------------------------------------------ #}
{% if htaccessHealth is not null %}
{% set criticalCount = htaccessHealth|filter(f => f.severity == 'critical')|length %}
<div id="htaccess-section" class="card mb-4">
    <div class="card-header">
        <h3 class="card-header-title">
            <i class="material-icons">healing</i>
            Santé du .htaccess
            {% if htaccessHealth is empty %}
            <span class="badge badge-success ml-2">Aucun problème</span>
            {% elseif criticalCount > 0 %}
            <span class="badge badge-danger ml-2">{{ criticalCount }} critique{{ criticalCount > 1 ? 's' }}</span>
            {% else %}
            <span class="badge badge-warning ml-2">{{ htaccessHealth|length }} point{{ htaccessHealth|length > 1 ? 's' }} à vérifier</span>
            {% endif %}
        </h3>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Fichier <code>{{ htaccessPath }}</code>. Chaque réparation, blocage ou déblocage crée une sauvegarde datée,
            restaurable depuis l'historique ci-dessous.
        </p>

        {# --- Diagnostic --- #}
        <h4 class="h5 mt-2">Diagnostic</h4>
        {% for f in htaccessHealth %}
        {% set tone = f.severity == 'critical' ? 'danger' : (f.severity == 'warning' ? 'warning' : 'info') %}
        <div class="pl-3 mb-3 border-{{ tone }}" style="border-left:4px solid">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <span class="badge badge-{{ tone }}">
                        {{ f.severity == 'critical' ? 'Critique' : (f.severity == 'warning' ? 'Attention' : 'Info') }}
                    </span>
                    <strong class="ml-1">{{ f.title }}</strong>
                    {% if f.lines is not empty %}
                    <small class="text-muted ml-1">ligne{{ f.lines|length > 1 ? 's' }} {{ f.lines|join(', ') }}</small>
                    {% endif %}
                </div>
                {% if f.fixable %}
                <form method="post" action="{{ path('sc_alwaysdata_htaccess_repair') }}" class="ml-3 flex-shrink-0">
                    <input type="hidden" name="_token" value="{{ csrf_token('sc_alwaysdata_htaccess') }}">
                    <input type="hidden" name="code" value="{{ f.code }}">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="material-icons">build</i> Réparer
                    </button>
                </form>
                {% endif %}
            </div>
            <p class="small mb-1 mt-1">{{ f.detail }}</p>
            {% if f.items is not empty %}
            <p class="small mb-0">{% for i in f.items %}<code>{{ i }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>
            {% endif %}
            {% if not f.fixable %}
            <p class="small text-muted mb-0"><em>Correction manuelle : le module ne touche pas à ce type de règle.</em></p>
            {% endif %}
        </div>
        {% else %}
        <p class="small text-success">Aucune règle morte, aucun robot légitime ni navigateur bloqué, structure équilibrée.</p>
        {% endfor %}

        {# --- Active blocks --- #}
        <h4 class="h5 mt-4">Blocages actifs</h4>
        {% if blockedUas is empty and blockedIps is empty %}
        <p class="small text-muted">Aucun robot ni aucune IP bloqués.</p>
        {% else %}
        <table class="table table-sm table-striped mb-2">
            <thead><tr><th>Type</th><th>Valeur</th><th class="text-right">Action</th></tr></thead>
            <tbody>
            {% for ua in blockedUas %}
            <tr>
                <td><span class="badge badge-secondary">Robot</span></td>
                <td><code>{{ ua }}</code></td>
                <td class="text-right">
                    <form method="post" action="{{ path('sc_alwaysdata_apply_unblock') }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('sc_alwaysdata_apply_block') }}">
                        <input type="hidden" name="type" value="ua">
                        <input type="hidden" name="value" value="{{ ua }}">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Débloquer</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
            {% for ip in blockedIps %}
            <tr>
                <td><span class="badge badge-dark">IP</span></td>
                <td><code>{{ ip }}</code></td>
                <td class="text-right">
                    <form method="post" action="{{ path('sc_alwaysdata_apply_unblock') }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('sc_alwaysdata_apply_block') }}">
                        <input type="hidden" name="type" value="ip">
                        <input type="hidden" name="value" value="{{ ip }}">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Débloquer</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        <p class="small text-muted">
            Un robot listé dans une règle combinée (<code>[OR]</code>) ne peut pas être débloqué seul :
            le module le signale et ne modifie rien.
        </p>
        {% endif %}
        <form method="post" action="{{ path('sc_alwaysdata_apply_block') }}" class="form-inline mb-2">
            <input type="hidden" name="_token" value="{{ csrf_token('sc_alwaysdata_apply_block') }}">
            <select name="type" class="form-control form-control-sm mr-2">
                <option value="ua">Robot (User-Agent)</option>
                <option value="ip">IP</option>
            </select>
            <input type="text" name="value" class="form-control form-control-sm mr-2" style="width:18rem" required
                   placeholder="ex. MJ12bot ou 203.0.113.7">
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="material-icons">block</i> Bloquer
            </button>
        </form>

        {# --- Backup history --- #}
        <h4 class="h5 mt-4">Historique des sauvegardes</h4>
        {% if htaccessBackups is empty %}
        <p class="small text-muted">Aucune sauvegarde : le module n'a encore rien écrit dans ce fichier.</p>
        {% else %}
        <p class="small text-muted">
            Restaurer remet le fichier dans l'état qui précédait l'écriture. L'état actuel est d'abord sauvegardé :
            une restauration s'annule depuis cette même liste.
        </p>
        <div class="d-flex align-items-center justify-content-between mb-2">
            <small class="text-muted">
                {{ htaccessBackupCount }} sauvegarde{{ htaccessBackupCount > 1 ? 's' }} sur le serveur{% if htaccessBackupCount > htaccessBackups|length %}, {{ htaccessBackups|length }} plus récentes affichées{% endif %}.
            </small>
            {% if htaccessBackupCount > backupsKeptOnPurge %}
            <form method="post" action="{{ path('sc_alwaysdata_htaccess_purge') }}" class="d-inline"
                  onsubmit="return confirm('Supprimer définitivement {{ htaccessBackupCount - backupsKeptOnPurge }} sauvegarde(s) ? Les {{ backupsKeptOnPurge }} plus récentes sont conservées.');">
                <input type="hidden" name="_token" value="{{ csrf_token('sc_alwaysdata_htaccess') }}">
                <input type="hidden" name="keep" value="{{ backupsKeptOnPurge }}">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="material-icons">delete_sweep</i>
                    Purger (garder les {{ backupsKeptOnPurge }} plus récentes)
                </button>
            </form>
            {% endif %}
        </div>
        <table class="table table-sm mb-0">
            <thead><tr><th>Date</th><th>Effet d'une restauration</th><th class="text-right">Action</th></tr></thead>
            <tbody>
            {% for b in htaccessBackups %}
            {% set unchanged = b.removed is empty and b.restored is empty %}
            <tr>
                <td class="text-nowrap"><small>{{ b.date }}</small></td>
                <td>
                    {% if unchanged %}
                    <small class="text-muted">Identique au fichier actuel</small>
                    {% else %}
                    <details>
                        <summary class="small">
                            {% if b.removed is not empty %}<span class="text-danger">−{{ b.removed|length }}</span>{% endif %}
                            {% if b.restored is not empty %}<span class="text-success ml-1">+{{ b.restored|length }}</span>{% endif %}
                            ligne{{ (b.removed|length + b.restored|length) > 1 ? 's' }}
                        </summary>
<pre class="small mb-0 mt-1 p-2 bg-light" style="max-height:15rem;overflow:auto">{% for l in b.removed %}<span class="text-danger">- {{ l }}</span>
{% endfor %}{% for l in b.restored %}<span class="text-success">+ {{ l }}</span>
{% endfor %}</pre>
                    </details>
                    {% endif %}
                </td>
                <td class="text-right">
                    <form method="post" action="{{ path('sc_alwaysdata_htaccess_restore') }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('sc_alwaysdata_htaccess') }}">
                        <input type="hidden" name="backup" value="{{ b.name }}">
                        <button type="submit" class="btn btn-sm btn-outline-warning" {% if unchanged %}disabled{% endif %}>
                            <i class="material-icons">restore</i> Restaurer
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
</div>
{% endif %}


{# ------------------------------------------------------------------ #}
{# Managed .htaccess protection (facets)                               #}
{# ------------------------------------------------------------------ #}
{% if protection is not null %}
<div id="protection-section" class="card mb-4">
    <div class="card-header">
        <h3 class="card-header-title">
            <i class="material-icons">shield</i>
            Protection .htaccess
            {% if protection.installed %}
            <span class="badge badge-success ml-2">Active</span>
            {% else %}
            <span class="badge badge-secondary ml-2">Inactive</span>
            {% endif %}
        </h3>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Bloc <code># BEGIN sc_alwaysdata protection</code> écrit en tête du .htaccess, avant les règles PrestaShop.
            Réponse 403 servie par Apache, sans PHP. Sauvegarde datée créée à chaque écriture.
        </p>
        <form method="post" action="{{ path('sc_alwaysdata_protection') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sc_alwaysdata_protection') }}">

            <div class="custom-control custom-checkbox mb-1">
                <input type="checkbox" class="custom-control-input" id="facet_referer" name="facet_referer" value="1"
                       {% if protection.facet_referer or not protection.installed %}checked{% endif %}>
                <label class="custom-control-label" for="facet_referer">
                    Facettes (<code>?q=</code>) réservées à la navigation depuis la boutique (contrôle du Referer)
                </label>
            </div>
            <p class="small text-muted ml-4 mb-3">
                Domaines autorisés ({{ shopDomains|length }}, lus depuis <code>shop_url</code>) :
                {% for d in shopDomains %}<code>{{ d }}</code>{% if not loop.last %}, {% endif %}{% else %}<span class="text-danger">aucun</span>{% endfor %}.
                Un favori ou lien de newsletter contenant <code>?q=</code> recevra un 403.
            </p>

            <div class="custom-control custom-checkbox mb-1">
                <input type="checkbox" class="custom-control-input" id="facet_depth" name="facet_depth" value="1"
                       {% if protection.facet_max_filters > 0 or not protection.installed %}checked{% endif %}>
                <label class="custom-control-label" for="facet_depth">
                    Limiter le nombre de familles de filtres combinées
                </label>
            </div>
            <div class="form-inline ml-4 mb-3">
                <label class="small mr-2" for="facet_max_filters">Maximum</label>
                <input type="number" class="form-control form-control-sm" id="facet_max_filters" name="facet_max_filters"
                       style="width:5rem" min="1" max="{{ facetMaxFiltersLimit }}"
                       value="{{ protection.facet_max_filters > 0 ? protection.facet_max_filters : 3 }}">
                <span class="small text-muted ml-2">familles (ex. Taille + Couleur + Marque = 3)</span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="material-icons">save</i>
                Appliquer
            </button>
            <small class="text-muted ml-2">Tout décocher puis appliquer retire le bloc.</small>
        </form>
    </div>
</div>
{% endif %}

</div>
</div>
