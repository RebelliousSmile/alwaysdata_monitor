{
    "name": "scriptami/sc_alwaysdata",
    "description": "Analyse les logs Alwaysdata et gère le fichier .htaccess",
    "type": "prestashop-module",
    "license": "AFL-3.0",
    "authors": [
        {
            "name": "Scriptami"
        }
    ],
    "autoload": {
        "psr-4": {
            "ScAlwaysdata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ScAlwaysdata\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox"
    },
    "config": {
        "preferred-install": "dist"
    }
}
