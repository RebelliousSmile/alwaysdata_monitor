# Point d'entrée HTTP du veilleur, publié par Caddy (deploy/Caddyfile.example).
[Unit]
Description=vigie serve (veilleur multi-sites)
After=network-online.target
Wants=network-online.target
# Avant le premier déploiement, l'unité est ignorée au lieu d'échouer en boucle.
ConditionFileIsExecutable=/home/vigie/vigie/bin/vigie
ConditionPathExists=/home/vigie/vigie/config.toml

[Service]
User=vigie
Group=vigie
Environment=IP=127.0.0.1 PORT=8080
ExecStart=/home/vigie/vigie/bin/vigie serve
Restart=on-failure
RestartSec=5
# Prioritaire sur les autres processus du VPS quand la mémoire manque.
OOMScoreAdjust=-500

# Durcissement : seule la base est accessible en écriture, pas le binaire.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/vigie/vigie/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
