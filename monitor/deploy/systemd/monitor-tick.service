# Passage du veilleur, lancé chaque minute par monitor-tick.timer. Tant qu'un
# passage tourne, le timer n'en démarre pas d'autre.
[Unit]
Description=monitor tick (veilleur multi-sites)
After=network-online.target
Wants=network-online.target
# Avant le premier déploiement, le passage est ignoré au lieu d'échouer.
ConditionFileIsExecutable=/home/monitor/monitor/bin/monitor
ConditionPathExists=/home/monitor/monitor/config.toml

[Service]
Type=oneshot
User=monitor
Group=monitor
ExecStart=/home/monitor/monitor/bin/monitor tick
TimeoutStartSec=120

# Durcissement : seule la base est accessible en écriture, pas le binaire.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/monitor/monitor/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
